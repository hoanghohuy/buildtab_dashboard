VITE_DATA_ARM=mock

# Tự chuyển tab kiosk (Tổng quan → Sơ đồ tổ chức → …). `false` khi debug.
VITE_KIOSK_AUTO_ROTATE=true

# ArcGIS Web Scene (ghi đè GIS_SCENE_STATIC trong GIS_CONFIG.ts nếu có giá trị)
VITE_ARCGIS_PORTAL_URL=https://onecadvietnam.maps.arcgis.com
VITE_ARCGIS_SCENE_ID=
VITE_ARCGIS_CLIENT_ID=
VITE_ARCGIS_USERNAME=
VITE_ARCGIS_PASSWORD=
